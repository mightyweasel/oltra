          "type": "word",
          "speaker_id": "speaker_2"
        }
      ]
    },
    {
      "language_code": "en",
      "language_probability": 1,
      "text": "That's something we haven't talked about yet: onboarding.",
      "channel_index": 3,
      "words": [
        {
          "text": "That's",
          "start": 245.450,
          "end": 245.750,
          "type": "word",
          "speaker_id": "speaker_3"
        },
        {
          "text": "onboarding.",
          "start": 247.200,
          "end": 247.650,
          "type": "word",
          "speaker_id": "speaker_3"
        }
      ]
    },
    {
      "language_code": "en",
      "language_probability": 1,
      "text": "I've found that junior employees often benefit from more intentional in-person time, especially during their first few months.",
      "channel_index": 3,
      "words": [
        {
          "text": "I've",
          "start": 247.950,
          "end": 248.200,
          "type": "word",
          "speaker_id": "speaker_3"
        },
        {
          "text": "months.",
          "start": 254.400,
          "end": 254.950,
          "type": "word",
          "speaker_id": "speaker_3"
        }
      ]
    },
    {
      "language_code": "fr",
      "language_probability": 1,
      "text": "C'est vrai, mais je pense qu'il faut aussi éviter de créer deux catégories d'employés.",
      "channel_index": 2,
      "words": [
        {
          "text": "C'est",
          "start": 255.250,
