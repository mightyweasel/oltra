          "text": "organizations.",
          "start": 282.000,
          "end": 282.550,
          "type": "word",
          "speaker_id": "speaker_1"
        }
      ]
    },
    {
      "language_code": "fr",
      "language_probability": 1,
      "text": "J'espère surtout que nous aurons appris à faire davantage confiance aux équipes.",
      "channel_index": 2,
      "words": [
        {
          "text": "J'espère",
          "start": 282.900,
          "end": 283.300,
          "type": "word",
          "speaker_id": "speaker_2"
        },
        {
          "text": "équipes.",
          "start": 287.200,
          "end": 287.650,
          "type": "word",
          "speaker_id": "speaker_2"
        }
      ]
    },
    {
      "language_code": "en",
      "language_probability": 1,
      "text": "For me, it's about making flexibility feel normal rather than exceptional.",
      "channel_index": 3,
      "words": [
        {
          "text": "For",
          "start": 288.000,
          "end": 288.200,
          "type": "word",
          "speaker_id": "speaker_3"
        },
