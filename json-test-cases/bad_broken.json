        {
          "text": "company.",
          "start": 30.500,
          "end": 31.000,
          "type": "word",
          "speaker_id": "speaker_0"
        }
      ]
    },
    {
      "language_code": "en",
      "language_probability": 1,
      "text": "Hi, thanks for having me.",
      "channel_index": 1,
      "words": [
        {
          "text": "Hi,",
          "start": 31.300,
