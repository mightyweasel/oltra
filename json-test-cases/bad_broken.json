          "type": "word",
          "speaker_id": "speaker_2"
        }
      ]
    },
    {
      "language_code": "fr",
      "language_probability": 1,
      "text": "Ceux qui ont accès aux meilleures interactions et ceux qui restent constamment à distance.",
