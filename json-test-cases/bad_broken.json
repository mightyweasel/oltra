          "speaker_id": "speaker_3"
        }
      ]
    },
    {
      "language_code": "en",
      "language_probability": 1,
      "text": "Maybe it'll just be work.",
      "channel_index": 0,
      "words": [
        {
          "text": "Maybe",
          "start": 298.000,
          "end": 298.300,
          "type": "word",
          "speaker_id": "speaker_0"
        },
