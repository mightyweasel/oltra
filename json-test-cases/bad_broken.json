          "text": "exceptional.",
          "start": 292.500,
          "end": 293.000,
          "type": "word",
          "speaker_id": "speaker_3"
        }
      ]
    },
    {
      "language_code": "fr",
      "language_probability": 1,
      "text": "Et peut-être que dans cinq ans, nous ne parlerons même plus de travail hybride.",
