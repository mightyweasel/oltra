          "text": "question.",
          "start": 270.000,
          "end": 270.450,
          "type": "word",
          "speaker_id": "speaker_0"
        }
      ]
    },
    {
      "language_code": "en",
      "language_probability": 1,
      "text": "If we were sitting here again five years from now, what would you hope has changed?",
      "channel_index": 0,
      "words": [
        {
          "text": "If",
          "start": 270.750,
          "end": 270.900,
          "type": "word",
          "speaker_id": "speaker_0"
        },
