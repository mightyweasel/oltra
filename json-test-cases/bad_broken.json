          "type": "word",
          "speaker_id": "speaker_2"
        }
      ]
    },
    {
      "language_code": "en",
      "language_probability": 1,
      "text": "And finally, Alex joins us with experience working across both Canadian and European teams.",
      "channel_index": 3,
      "words": [
        {
          "text": "And",
          "start": 40.550,
          "end": 40.780,
          "type": "word",
