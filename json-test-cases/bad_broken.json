          "type": "word",
          "speaker_id": "speaker_2"
        }
      ]
    },
    {
      "language_code": "en",
      "language_probability": 1,
      "text": "And that brings us to the final question.",
      "channel_index": 0,
      "words": [
        {
          "text": "And",
          "start": 267.450,
          "end": 267.650,
          "type": "word",
          "speaker_id": "speaker_0"
        },
