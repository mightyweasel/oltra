          "text": "changed?",
          "start": 275.500,
          "end": 276.000,
          "type": "word",
          "speaker_id": "speaker_0"
        }
      ]
    },
    {
      "language_code": "en",
      "language_probability": 1,
      "text": "I'd hope we're talking less about where people work and more about how we build effective organizations.",
      "channel_index": 1,
      "words": [
        {
          "text": "I'd",
          "start": 276.350,
          "end": 276.600,
          "type": "word",
          "speaker_id": "speaker_1"
        },
