          "text": "perspectives.",
          "start": 25.000,
          "end": 25.550,
          "type": "word",
          "speaker_id": "speaker_0"
        }
      ]
    },
    {
      "language_code": "en",
      "language_probability": 1,
      "text": "First, we have Daniel, who leads workplace strategy for a large technology company.",
      "channel_index": 1,
      "words": [
        {
          "text": "First,",
          "start": 25.850,
          "end": 26.180,
