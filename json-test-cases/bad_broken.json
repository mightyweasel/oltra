          "type": "word",
          "speaker_id": "speaker_0"
        }
      ]
    },
    {
      "language_code": "fr",
      "language_probability": 1,
      "text": "Exactement.",
      "channel_index": 2,
      "words": [
        {
          "text": "Exactement.",
